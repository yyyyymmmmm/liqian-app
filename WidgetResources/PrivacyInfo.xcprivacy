<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  礼记 · Widget 扩展隐私清单（v4.5 新增）

  必备理由 API 按代码实测申报（2026-11-07 核查 Sources/LiqianWidget）：
  扩展只通过 App Group 的 UserDefaults 读待回礼速览、写「记一笔」标记，
  不用 UserDefaults.standard，其余四类必备理由 API 均无调用。
  → UserDefaults 只申报 1C8F.1（同 App Group 内访问）。

  数据收集：扩展只在本机读写 App Group 数据，不外发、不收集，
  NSPrivacyCollectedDataTypes 为空数组。
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
